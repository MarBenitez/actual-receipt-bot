# Copy this file to .env and fill it in. Never commit .env: it holds your bot token and your passwords.
# Put each value right after the "=", with nothing else on the line. Leave optional values empty.

# The token @BotFather gives you
TELEGRAM_TOKEN=
# Your Telegram user ID (message the bot and it tells you). Several people: comma-separated
ALLOWED_USER_IDS=
# Where expenses go: empty for Actual Budget, or sheets for Google Sheets
DESTINO=

# --- Actual Budget (leave empty if you use Google Sheets) ---
# e.g. http://actual_server:5006 (same Docker network) or https://your-actual-domain
ACTUAL_SERVER_URL=
# The password you use to log in to Actual. Wrap it in single quotes
ACTUAL_PASSWORD=
# Actual: Settings > Show advanced settings > Sync ID
ACTUAL_SYNC_ID=
# Name of the account where expenses go, e.g. Checking
ACTUAL_ACCOUNT=
# Optional: only if your budget uses end-to-end encryption
ACTUAL_BUDGET_PASSWORD=
# Optional: Docker network of your Actual container (see README). Empty means actual_default
ACTUAL_NETWORK=

# --- Google Sheets (only with DESTINO=sheets) ---
# The web app URL you get when you deploy the sheet's Apps Script (ends in /exec)
SHEETS_URL=
# Your sheet's secret: menu "Bot de gastos" > "Ver mi secreto para el bot"
SHEETS_SECRET=
