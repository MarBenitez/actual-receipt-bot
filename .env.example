# Copy this file to .env and fill it in. Never commit .env: it holds your bot token and your Actual password.
TELEGRAM_TOKEN=          # the token @BotFather gives you
ALLOWED_USER_IDS=        # your Telegram user ID (message the bot and it tells you); comma-separated for several people
ACTUAL_SERVER_URL=       # e.g. http://actual:5006 (same Docker network) or https://your-actual-domain
ACTUAL_PASSWORD=         # the password you use to log in to Actual
ACTUAL_SYNC_ID=          # Actual: Settings > Show advanced settings > Sync ID
ACTUAL_ACCOUNT=          # name of the account where expenses go, e.g. Checking
ACTUAL_BUDGET_PASSWORD=  # only if your budget uses end-to-end encryption
ACTUAL_NETWORK=          # Docker network of your Actual container (see README). Default: actual_default
